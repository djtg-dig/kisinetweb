# URL Django accessible depuis le serveur Next.js, jamais exposée au navigateur.
KISINET_BACKEND_URL=http://127.0.0.1:8002

# Identité du client applicatif Web enregistrée côté backend Django.
KISINET_HMAC_CLIENT_ID=kisinet-web
KISINET_HMAC_SIGNATURE_VERSION=v1

# Secret HMAC serveur uniquement : utiliser une valeur locale ou d'infrastructure.
# Exemple local temporaire :
# KISINET_HMAC_SECRET=test-hmac-secret-for-kisinet-web
KISINET_HMAC_SECRET=
